# The repo stores text as LF. Without this, a contributor whose Git sets
# core.autocrlf=true commits CRLF and the diff swallows a whole file.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.ttf binary
*.mp3 binary
*.wav binary
*.zip binary

# Shared casino vectors are hashed byte for byte against the backend copy.
src/Aetherphone.Tests/Vectors/plinko.json -text

# The slot machine vectors are hashed byte for byte here and in the backend, so they never get a
# line-ending conversion on checkout.
src/Aetherphone.Tests/Vectors/slots-*.json -text

<Project>

  <!--
    Single source of truth for cross-project MSBuild settings.
    Mirrors the suite convention: Version drives CI tagging/release.
  -->

  <PropertyGroup Label="Identity">
    <Version>1.0.1.9</Version>
    <Authors>XeldarAlz</Authors>
    <Copyright>Copyright (c) XeldarAlz</Copyright>
    <PackageProjectUrl>https://github.com/XeldarAlz/FFXIV-Aetherphone</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/XeldarAlz/FFXIV-Aetherphone</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Label="Determinism" Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <!-- CI only: a warning nobody fails on is a warning nobody reads. Local
         builds stay warn-only so a work in progress still compiles. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Code style is enforced by the compiler, not by review. Without
    EnforceCodeStyleInBuild the IDE rules in .editorconfig fire in an editor
    and under dotnet format but never during a build, so CI never sees them.
    ManagedDoom opts out of all three in its own csproj.
  -->
  <PropertyGroup Label="CodeStyle">
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
  </PropertyGroup>

  <!--
    Dalamud ships x64-stamped assemblies. On an arm64 host the harness
    bootstrap retargets them so they load, which makes the compiler warn
    that they target a different processor. Windows CI never sees this.
  -->
  <PropertyGroup Label="HostArchitecture" Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <NoWarn>$(NoWarn);CS8012</NoWarn>
  </PropertyGroup>

  <!--
    A machine without Dalamud installed builds against the cache that
    tools/harness/Bootstrap fills, unless DALAMUD_HOME says otherwise.
  -->
  <PropertyGroup Label="DalamudFallback" Condition="'$(DALAMUD_HOME)' == ''">
    <HarnessCache Condition="'$(AETHERPHONE_HARNESS_CACHE)' != ''">$(AETHERPHONE_HARNESS_CACHE)</HarnessCache>
    <HarnessCache Condition="'$(HarnessCache)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">$(USERPROFILE)\.aetherphone-harness</HarnessCache>
    <HarnessCache Condition="'$(HarnessCache)' == ''">$(HOME)/.aetherphone-harness</HarnessCache>
    <DalamudDefaultInstall Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(appdata)\XIVLauncher\addon\Hooks\dev\Dalamud.dll</DalamudDefaultInstall>
    <DalamudDefaultInstall Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(HOME)/.xlcore/dalamud/Hooks/dev/Dalamud.dll</DalamudDefaultInstall>
    <DalamudDefaultInstall Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(HOME)/Library/Application Support/XIV on Mac/dalamud/Hooks/dev/Dalamud.dll</DalamudDefaultInstall>
    <DALAMUD_HOME Condition="!Exists('$(DalamudDefaultInstall)') And Exists('$(HarnessCache)/dalamud/Dalamud.dll')">$(HarnessCache)/dalamud</DALAMUD_HOME>
  </PropertyGroup>

  <PropertyGroup Label="Restore">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>

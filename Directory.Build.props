<Project>

  <!--
    Single source of truth for cross-project MSBuild settings.
    Mirrors the suite convention: Version drives CI tagging/release.
  -->

  <PropertyGroup Label="Identity">
    <Version>1.1.0.4</Version>
    <Authors>XeldarAlz</Authors>
    <Copyright>Copyright (c) XeldarAlz</Copyright>
    <PackageProjectUrl>https://github.com/XeldarAlz/FFXIV-Aetherphone</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/XeldarAlz/FFXIV-Aetherphone</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Label="Determinism" Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <!-- CI only: a warning nobody fails on is a warning nobody reads. Local
         builds stay warn-only so a work in progress still compiles. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Code style is enforced by the compiler, not by review. Without
    EnforceCodeStyleInBuild the IDE rules in .editorconfig fire in an editor
    and under dotnet format but never during a build, so CI never sees them.
    ManagedDoom opts out of all three in its own csproj.
  -->
  <PropertyGroup Label="CodeStyle">
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup Label="Restore">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!--
    ImageSharp 3.1.12 advisories published 2026-10-07. The only fix is 4.1.2,
    which needs a Six Labors license key at build time. Remove these once the
    package is upgraded.
  -->
  <ItemGroup Label="AuditSuppressions">
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
  </ItemGroup>

</Project>
